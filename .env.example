# ---------- API (apps/api) ----------
# Runtime environment: dev | test | prod
ENV=dev
# Log level for structlog
LOG_LEVEL=INFO
# Git commit SHA baked into the Docker image, shown by /health
GIT_SHA=dev
# Allowed CORS origins in local dev (JSON list)
CORS_ORIGINS=["http://localhost:3000"]
# Public URL of the web app
WEB_URL=http://localhost:3000

# Postgres + pgvector (docker-compose locally, Supabase in prod; use the asyncpg driver)
DATABASE_URL=postgresql+asyncpg://newshelper:newshelper@localhost:5432/newshelper

# File storage backend: local (disk) or supabase
STORAGE_BACKEND=local
# Folder used by the local storage backend
STORAGE_LOCAL_DIR=./.storage
# Supabase project URL (prod storage)
SUPABASE_URL=
# Supabase service-role key (server only, never expose to the browser)
SUPABASE_SERVICE_KEY=
# Supabase Storage bucket for PDFs and audio
SUPABASE_BUCKET=editions

# Secret used to sign session JWTs (openssl rand -hex 32)
JWT_SECRET=
# Session lifetime in days
JWT_EXPIRY_DAYS=7
# Shared secret required in the X-Cron-Secret header on /internal routes (openssl rand -hex 32)
CRON_SECRET=
# Email of the seeded demo account used by "Try the demo"
DEMO_EMAIL=demo@newshelper.app

# Anthropic API key for summaries, onboarding parsing and the editor
ANTHROPIC_API_KEY=
# Cheap model for bulk work (summaries, parsing)
LLM_FAST_MODEL=claude-haiku-5-5
# Strong model for the once-a-day editor call
LLM_SMART_MODEL=claude-sonnet-5-5
# Daily LLM spend cap in USD; above it summaries fall back to extractive
LLM_DAILY_BUDGET_USD=2.0
# Local embedding model (fastembed) and its vector size
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384

# Languages kept during ingestion (JSON list)
ALLOWED_LANGUAGES=["en"]
# Enable the Reddit fetcher
REDDIT_ENABLED=false
# Optional Apify token; enables fallback scrapers only when set
APIFY_TOKEN=
# Apify actor used to decode Google News links when open-source decoding fails
APIFY_GNEWS_ACTOR=hiver/google-news-scraper
# Apify actor used as last-resort full-text extractor
APIFY_EXTRACT_ACTOR=apify/website-content-crawler

# Optional ElevenLabs key for the audio edition (browser voice used otherwise)
ELEVENLABS_API_KEY=

# ---------- Web (apps/web) ----------
# Where Next.js rewrites /api/* to
API_URL=http://localhost:8000

# ---------- Deploy (GitHub Actions secrets, not used locally) ----------
# RENDER_DEPLOY_HOOK_URL=
# VERCEL_TOKEN=
# VERCEL_ORG_ID=
# VERCEL_PROJECT_ID=
